              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      subtitle: \'A world inhabited entirely by robots \342\200\224 rovers, landers, and the first aircraft to fly on another planet.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
