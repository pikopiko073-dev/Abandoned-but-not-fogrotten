            lines {
              text: "// ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export const EXHIBITS: Exhibit[] = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // ------------------------------ MOON EXHIBITS ------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'apollo-11-eagle\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Moon\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Apollo 11 Lunar Module \"Eagle\"\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'1969\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 0.6741,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 23.473,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'On July 20, 1969, the Lunar Module Eagle carried Neil Armstrong and Buzz Aldrin to a safe touchdown on the Sea of Tranquility with less than 30 seconds of landing fuel remaining. When the astronauts blasted off to rejoin command module Columbia, Eagle\342\200\231s gold-foiled descent stage stayed behind as their launch pad. Because the Moon has no wind or rain, the octagonal base and the astronauts\342\200\231 bootprints around it remain preserved in the gray lunar dust.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Proved that humans could land precisely on another world, walk on its surface, and return ancient volcanic basalt rocks that revealed the Moon formed over 4.5 billion years ago.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A four-legged spider-like landing base wrapped in shiny gold thermal blankets to block extreme heat and cold, plus a throttleable rocket engine and shock-absorbing aluminum honeycomb legs.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'21.6 hours on surface\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'21.6 hours active (resting intact since 1969)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/apollo-11/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Apollo 11 \"Eagle\" Descent Stage\', \'1969\', \'Moon\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Mare Tranquillitatis (Sea of Tranquility)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'2,033 kg (dry descent stage)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'apollo-11-lrrr\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Moon\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Apollo 11 Laser Retroreflector\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'1969\342\200\223Present\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'STILL WORKING\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 0.6734,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 23.4729,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Placed on the lunar soil just steps away from the Apollo 11 lander, this suitcase-sized tray of special glass prisms requires zero batteries or electricity. Observatories on Earth fire powerful laser pulses at it and time how long a single photon takes to bounce back. More than five decades after Apollo 11 left the Moon, scientists still bounce lasers off this mirror array every week.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Revealed that the Moon is slowly spiraling away from Earth by about 3.8 centimeters (1.5 inches) every single year\342\200\224about the speed your fingernails grow\342\200\224and proved the Moon has a partially fluid core.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'An aluminum frame holding 100 fused-silica \"corner-cube\" prisms that bounce any incoming beam of light straight back in the exact direction it came from.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'10 years of measurements\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'55+ years (still reflecting lasers today)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/apollo-11/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Apollo 11 Laser Retroreflector\', \'1969\342\200\223Present\', \'Moon\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Mare Tranquillitatis (Sea of Tranquility)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'23.6 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedVsRealityFeatured: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedRatioPercent: 18,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    multiplierText: \'5.5\303\227 longer and counting\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'surveyor-3\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Moon\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Surveyor 3 Robotic Lander\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'1967\342\200\2231969\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: -3.0155,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: -23.418,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Surveyor 3 bounced twice during its automated landing in the Ocean of Storms in April 1967 before settling inside a gentle crater. It used a small mechanical scoop to dig trenches and test how strong the lunar soil was before human astronauts arrived. Two and a half years later, Apollo 12 astronauts Pete Conrad and Alan Bean landed right next to it and walked over to inspect the dusty robot in person.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confirmed that the lunar surface was firm enough to support heavy Apollo spacecraft without sinking, and showed how solar radiation and micrometeorites weather metal and glass over time.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A triangular aluminum frame with three folding shock-absorber legs, a rotating mirror television camera, and an electric claw arm on a folding pantograph hinge.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'14 Earth days (1 lunar day)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'14 days active (visited by astronauts in 1969)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/surveyor-3/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Surveyor 3 Lander\', \'1967\342\200\2231969\', \'Moon\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Oceanus Procellarum (Ocean of Storms)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'296 kg (landed mass)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'apollo-15-rover\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Moon\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Apollo 15 Lunar Roving Vehicle\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'1971\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 26.1322,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 3.6339,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Nicknamed the \"Moon Buggy,\" this folding electric car arrived tucked tightly inside the side of the Apollo 15 lander like a giant mechanical origami kit. Astronauts Dave Scott and Jim Irwin unfolded it and drove 27.9 kilometers across rugged craters and along the edge of Hadley Rille canyon. Before leaving, they parked the rover and pointed its television camera at their spacecraft so people on Earth could watch them blast off live.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Allowed astronauts to travel far beyond walking distance to collect the famous 4.1-billion-year-old \"Genesis Rock\" from the Apennine Mountains.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A featherweight aluminum chassis with four independent electric motors, woven piano-wire mesh tires that never go flat, and a T-shaped joystick controller instead of a steering wheel.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'3 lunar surface drives (~3 hours total)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'3 hours 2 minutes driven (27.9 km)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/apollo-15/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Apollo 15 Lunar Roving Vehicle\', \'1971\', \'Moon\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Hadley\342\200\223Apennine Region\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'210 kg (empty weight on Earth)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'ladee\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Moon\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'LADEE Lunar Atmosphere Explorer\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'2013\342\200\2232014\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'ENDED ON PURPOSE\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 11.97,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: -93.25,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The Lunar Atmosphere and Dust Environment Explorer (LADEE) skimmed just 20 kilometers above the Moon\342\200\231s craters to study its ultra-thin exosphere and floating dust particles. Because the Moon\342\200\231s lumpy gravity pulls low-flying spacecraft downward once their fuel runs out, engineers steered LADEE to crash on the far side of the Moon away from historic Apollo landing sites. It struck the rim of Sundman V crater at over 5,800 kilometers per hour in April 2014.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Discovered that tiny meteoroid showers constantly kick up a halo of microscopic lunar dust and measured neon, helium, and argon atoms in the Moon\342\200\231s whisper-thin exosphere.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A modular carbon-composite cylinder carrying a dust impact detector, an ultraviolet spectrometer, and a high-speed laser communications terminal that beamed data to Earth at broadband speeds.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'100 days of science\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'128 days of science (deliberate far-side impact)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/ladee/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'LADEE Lunar Orbiter\', \'2013\342\200\2232014\', \'Moon\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Sundman V Crater Rim (Lunar Far Side)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'248.2 kg (dry mass)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // ------------------------------ MARS EXHIBITS ------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'ingenuity\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Mars\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Ingenuity\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'2021\342\200\2232024\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 18.4447,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 77.4508,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Tucked underneath the belly of the Perseverance rover, Ingenuity was designed as a risky 30-day experiment to see if a helicopter could fly in Mars\342\200\231s paper-thin air, which has just 1% the density of Earth\342\200\231s atmosphere. Not only did it lift off on April 19, 2021\342\200\224carrying a postage-stamp piece of fabric from the Wright brothers\342\200\231 1903 airplane\342\200\224it transformed into an aerial scout for the rover. After 72 flights across nearly three years, a hard landing in sandy ripples damaged its carbon-fiber rotor blades in January 2024, leaving it standing upright in Valinor Hills.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Proved that powered, controlled flight is possible in the ultra-thin Martian atmosphere and scouted rocky trails from the air to help rovers plan safer routes.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A tissue-box-sized body weighing just 1.8 kilograms on Earth, spun aloft by two 1.2-meter carbon-fiber propellers rotating at 2,400 RPM\342\200\224about five times faster than a passenger helicopter on Earth.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'5 flights\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'72 flights\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/mars-2020-perseverance/ingenuity-mars-helicopter/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Ingenuity Mars Helicopter\', \'2021\342\200\2232024\', \'Mars\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Jezero Crater / Valinor Hills\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'1.8 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedVsRealityFeatured: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedRatioPercent: 7,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    multiplierText: \'14.4\303\227 more flights than planned\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'opportunity\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Mars\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Opportunity\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'2004\342\200\2232018\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: -1.9462,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: -5.5266,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Bouncing to a stop inside a giant cluster of airbags in January 2004, Opportunity rolled out into Eagle Crater on a mission expected to last just 90 Martian days before dust smothered its solar panels. Instead, helpful Martian whirlwinds repeatedly blew the dust off its wings, allowing \"Oppy\" to drive a record-shattering 45.16 kilometers\342\200\224more than a full marathon on another planet. In June 2018, a planet-encircling dust storm blotted out the Sun over Perseverance Valley, putting the rover into a deep sleep from which it never woke.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Found tiny spherical mineral \"blueberries\" made of hematite and ancient gypsum veins that proved liquid water once soaked the ground and pooled on the surface of Mars.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A six-wheeled golf-cart-sized solar rover with a \"rocker-bogie\" suspension that climbed over boulders, a panoramic camera mast at human eye level, and a diamond-tipped rock abrasion grinder on its robotic arm.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'90 days\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'about 14 years\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/mer-opportunity/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Opportunity Rover (MER-B)\', \'2004\342\200\2232018\', \'Mars\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Meridiani Planum / Perseverance Valley\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'185 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedVsRealityFeatured: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedRatioPercent: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    multiplierText: \'57\303\227 longer than planned (5,111 sols)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'curiosity\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Mars\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Curiosity\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'2012\342\200\223Present\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'STILL WORKING\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: -4.5895,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 137.4417,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Too heavy for landing airbags, Curiosity was lowered to the floor of Gale Crater in August 2012 on steel cables from a hovering rocket-powered \"Sky Crane.\" For over a decade, the car-sized rover has been steadily climbing the layered foothills of Mount Sharp, drilling dozens of holes into ancient mudstones and sandstones. Even with battered aluminum wheels punctured by sharp Martian rocks, Curiosity continues analyzing rock powder in its onboard chemistry labs today.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Discovered that ancient Gale Crater held a calm freshwater lake billions of years ago with all the chemical building blocks\342\200\224carbon, hydrogen, nitrogen, oxygen, phosphorus, and sulfur\342\200\224needed to support microbial life.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'An SUV-sized rolling laboratory powered by a heat-generating plutonium battery (MMRTG), equipped with a rock-vaporizing head laser (ChemCam), a rotary percussion drill, and two internal chemical ovens.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'2 years\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'12+ years (still climbing Mount Sharp)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/msl-curiosity/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Curiosity Rover (MSL)\', \'2012\342\200\223Present\', \'Mars\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Gale Crater / Aeolis Mons (Mount Sharp)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'899 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedVsRealityFeatured: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedRatioPercent: 16,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    multiplierText: \'6\303\227 planned lifetime and still active\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'perseverance\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Mars\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Perseverance\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'2021\342\200\223Present\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'STILL WORKING\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 18.38,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 77.58,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Touching down in the ancient river delta of Jezero Crater in February 2021, Perseverance is the most advanced robotic astrobiologist ever sent to Mars. As it drives across dried-up riverbeds and crater rims, it cores chalk-sized cylinders of Martian rock and seals them inside ultra-clean titanium tubes for a future return mission to Earth. Along the way, it recorded the first actual audio of Martian wind and produced breathable oxygen straight out of Mars\342\200\231s carbon dioxide air.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Collected core samples of igneous and sedimentary lakebed rocks containing organic molecules and proved with the MOXIE experiment that future astronauts can manufacture oxygen directly from the Martian atmosphere.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A nuclear-powered six-wheeled rover featuring 23 cameras, two microphones, a ground-penetrating radar, an oxygen-making toaster-sized box (MOXIE), and a complex robotic carousel of 43 titanium sample tubes.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'2 years\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'4+ years (actively collecting samples)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/mars-2020-perseverance/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Perseverance Rover\', \'2021\342\200\223Present\', \'Mars\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Jezero Crater River Delta\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'1,025 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'sojourner\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Mars\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Sojourner\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'1997\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 19.13,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: -33.22,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'On July 4, 1997, the Mars Pathfinder lander unfolded its petal-like ramps in Ares Vallis and released Sojourner, the very first wheeled rover ever to drive on Mars. Only about the size of a microwave oven, Sojourner stayed close to its base station so Pathfinder could relay its radio signals back to Earth. It spent 83 Martian days sniffing boulders given cartoon names like \"Barnacle Bill\" and \"Yogi\" before the base lander\342\200\231s battery grew too cold to wake up.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Demonstrated that low-cost airbag landings and small six-wheeled rovers work on Mars, and found rounded pebbles suggesting catastrophic ancient floods once rushed through Ares Vallis.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A 10.6-kilogram six-wheeled mini-rover topped with a flat solar panel, insulated against freezing Martian nights with ultra-light silica aerogel (\"frozen smoke\"), and carrying an X-ray rock sensor on its nose.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'7 days\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'83 days\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/mars-pathfinder/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Sojourner Rover\', \'1997\', \'Mars\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Ares Vallis (Carl Sagan Memorial Station)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'10.6 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedVsRealityFeatured: true,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedRatioPercent: 8,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    multiplierText: \'11.8\303\227 longer than planned\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'insight\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Mars\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'InSight Lander\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'2018\342\200\2232022\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'SILENT\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 4.5024,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: 135.6234,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Unlike rovers built to roll across craters, InSight landed on the flat plains of Elysium Planitia in November 2018 to stay completely still and listen to the heartbeat of Mars. Using its robotic arm, it placed an ultra-sensitive dome-covered seismometer directly onto the ground to detect rumbles deep inside the planet. Over four years, fine red dust gradually coated its round solar panels until the lander sent home one final dusty selfie in December 2022 and powered down forever.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Detected more than 1,300 \"marsquakes\" and meteoroid impacts, allowing scientists to measure the exact thickness of Mars\342\200\231s crust, mantle, and surprisingly large liquid iron-alloy core.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A stationary three-legged platform with two circular fan-folded solar arrays, a robotic arm, a weather station, and a vacuum-sealed seismic sensor sensitive enough to detect vibrations smaller than a hydrogen atom.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'2 years\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'4 years\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/insight/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'InSight Mars Lander\', \'2018\342\200\2232022\', \'Mars\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Elysium Planitia\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'358 kg\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // --------------------------- DEEP SPACE EXHIBITS ---------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'voyager-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    zone: \'Deep Space\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name: \'Voyager 1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    years: \'1977\342\200\223Present\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status: \'STILL WORKING\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lat: 34.9,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lng: -101.2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    story:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Launched on September 5, 1977, Voyager 1 flew past Jupiter and Saturn before using Saturn\342\200\231s gravity to sling itself northward out of the plane of the planets. On Valentine\342\200\231s Day 1990, from 6 billion kilometers away, it turned its camera backward one last time to snap the famous \"Pale Blue Dot\" portrait of Earth suspended in a sunbeam. In August 2012, Voyager 1 crossed the heliopause to become the first human-made object to enter interstellar space, where it still whispers back to Earth across more than 22light-hours of emptiness.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    learned:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Revealed active volcanoes on Jupiter\342\200\231s moon Io, intricate ringlets and shepherd moons at Saturn, a thick nitrogen haze on Titan, and the first direct particle readings of the interstellar medium between the stars.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardware:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A 10-sided electronics bus crowned by a 3.7-meter white dish antenna, powered by three plutonium radioisotope generators, running on 69 kilobytes of computer memory, and carrying the gold-plated Copper Phonograph Record of Earth sounds and greetings.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    planned: \'5 years (Jupiter & Saturn flybys)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actual: \'47+ years (still communicating from interstellar space)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    source: \'https://science.nasa.gov/mission/voyager/voyager-1/\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image: createGrayHardwarePlaceholder(\'Voyager 1 Interstellar Probe\', \'1977\342\200\223Present\', \'Deep Space\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    distanceFromEarth: \'24.6 billion km (164.5 AU)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    distanceAu: 164.5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    landingSite: \'Interstellar Space (Constellation Ophiuchus direction)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    massKg: \'721.9 kg (launch mass)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    plannedVsRealityFeatured: true,"
