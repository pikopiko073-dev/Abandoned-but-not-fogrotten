          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform sampler2D u_water_texture;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform vec3 u_sun_pos;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform vec3 u_umbra_pos;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_has_umbra;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_show_penumbra;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_show_terminator;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_contrast;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_brightness;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_gamma;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_saturation;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_night_brightness;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_ocean_specular;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_terminator_glow;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_umbra_ring_glow;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec3 vNormalWorld;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec3 vPositionWorld;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec2 vUv;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        void main() {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec3 dayColor = texture2D(u_day_texture, vUv).rgb;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec3 nightColor = texture2D(u_night_texture, vUv).rgb;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float isWater = texture2D(u_water_texture, vUv).r;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // 1. Crystal Clear Earth Tone (Refined photorealistic balance with manual dat.gui controls)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec3 luma = vec3(dot(dayColor, vec3(0.299, 0.587, 0.114)));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          dayColor = mix(luma, dayColor, u_saturation);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          dayColor = pow(dayColor, vec3(u_gamma)) * u_brightness;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          dayColor = (dayColor - 0.5) * u_contrast + 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          dayColor = max(vec3(0.0), dayColor);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Elevate deep oceans to a clear, elegant sapphire-teal balance"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if (isWater > 0.5) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dayColor = mix(dayColor, dayColor * vec3(0.92, 1.08, 1.25), 0.35);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Soften night texture contrast and enhance city light warmth"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          nightColor = pow(nightColor, vec3(0.80)) * u_night_brightness + vec3(0.015, 0.02, 0.03);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // 2. Calculate Sun Illumination & Day-Night Terminator"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec3 sunDir = normalize(u_sun_pos);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float ndotl = dot(vPositionWorld, sunDir);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Smooth, crisp day/night terminator"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float terminatorWidth = 0.07;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float dayFactor = smoothstep(-terminatorWidth, terminatorWidth, ndotl);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if (u_show_terminator < 0.5) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dayFactor = 1.0;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Warm atmospheric sunset terminator glow along the day/night boundary"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float terminatorGlow = smoothstep(-0.10, 0.03, ndotl) * (1.0 - smoothstep(0.0, 0.15, ndotl));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec3 sunsetTint = vec3(0.98, 0.55, 0.25); // refined sunset copper glow"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // 3. Scientifically Accurate Solar Eclipse Shadow (Umbra + Penumbra + Twilight Ring)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float shadowDarkness = 0.0;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float umbraRingGlow = 0.0;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if (u_has_umbra > 0.5 && ndotl > -0.15) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            vec3 umbraDir = normalize(u_umbra_pos);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            vec3 toPoint = vPositionWorld - umbraDir;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            float alongSun = dot(toPoint, sunDir);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            vec3 perpVec = toPoint - alongSun * sunDir;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            float distFromAxis = length(perpVec);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            float umbraRadius = 0.014; // ~100 km pitch-black totality core"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            float penumbraRadius = 0.58; // ~3700 km wide partial eclipse zone"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            if (distFromAxis <= umbraRadius) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              // Deep pitch-black totality core (only 1% ambient starlight reaches ground)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              shadowDarkness = mix(0.992, 0.965, smoothstep(0.0, umbraRadius, distFromAxis));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            } else if (distFromAxis < penumbraRadius && u_show_penumbra > 0.5) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              // Non-linear scientific solar obscuration curve (proportional to overlapping lunar/solar discs)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              float t = (distFromAxis - umbraRadius) / (penumbraRadius - umbraRadius);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              float obscuration = pow(1.0 - clamp(t, 0.0, 1.0), 1.85);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              shadowDarkness = obscuration * 0.94;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            // 360\302\260 Umbral Sunset Twilight Halo"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            float ringDistance = abs(distFromAxis - umbraRadius * 1.35);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            umbraRingGlow = exp(-ringDistance * 85.0) * smoothstep(-0.05, 0.2, ndotl);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            // Apply shadow only where sun reaches"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            shadowDarkness *= smoothstep(-0.1, 0.05, ndotl);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // 4. Combine day, night, and solar eclipse shadow"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Effective daylight reaches surface only where not blocked by Moon\'s shadow"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          float effectiveSunlight = dayFactor * (1.0 - shadowDarkness);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec3 finalColor = mix(nightColor, dayColor, smoothstep(0.0, 0.12, effectiveSunlight));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Add realistic ocean specular reflection (Sun Glint on water!)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if (isWater > 0.5 && effectiveSunlight > 0.02) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            vec3 viewDir = normalize(cameraPosition - (vPositionWorld * 100.0));"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            vec3 halfDir = normalize(sunDir + viewDir);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            float spec = pow(max(0.0, dot(vNormalWorld, halfDir)), 32.0);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            finalColor += vec3(1.0, 0.92, 0.80) * spec * effectiveSunlight * u_ocean_specular;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Add sunset terminator glow where sunlight is grazing the horizon (Controlled by GUI)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if (u_show_terminator > 0.5 && u_terminator_glow > 0.001) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            finalColor += sunsetTint * terminatorGlow * (1.0 - shadowDarkness) * u_terminator_glow;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          // Add 360\302\260 Umbral Twilight Ring (Golden Sunset Halo around Totality Core, Controlled by GUI)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if (umbraRingGlow > 0.0 && u_umbra_ring_glow > 0.001) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            vec3 umbraHaloColor = vec3(0.96, 0.62, 0.15); // Solar Gold corona ring"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            finalColor += umbraHaloColor * umbraRingGlow * u_umbra_ring_glow;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          gl_FragColor = vec4(finalColor, 1.0);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      `"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const earthMesh = new THREE.Mesh(earthGeo, earthMat);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    scene.add(earthMesh);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    earthMeshRef.current = earthMesh;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // Asynchronously load high-res NASA Blue Marble, Earth at Night & Specular Water CDN textures"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const textureLoader = new THREE.TextureLoader();"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    textureLoader.crossOrigin = \'anonymous\';"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const maxAniso = renderer.capabilities.getMaxAnisotropy();"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    textureLoader.load("
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      \'https://unpkg.com/three-globe@2.31.1/example/img/earth-blue-marble.jpg\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      (tex) => {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        tex.colorSpace = THREE.SRGBColorSpace;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        tex.anisotropy = maxAniso;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        tex.minFilter = THREE.LinearMipmapLinearFilter;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        tex.magFilter = THREE.LinearFilter;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        earthMat.uniforms.u_day_texture.value = tex;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        earthMat.needsUpdate = true;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    textureLoader.load("
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      \'https://unpkg.com/three-globe@2.31.1/example/img/earth-night.jpg\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      (tex) => {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
