      id: "call_164450419193919732"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"@import \\\"tailwindcss\\\";\\n@custom-variant dark (&:where(.dark, .dark *));\\n\\n@layer base {\\n  body {\\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', sans-serif;\\n    background-color: #07090E;\\n    color: #F1F5F9;\\n    letter-spacing: 0.005em;\\n  }\\n\\n  h1, h2, .font-display {\\n    font-family: \'Fraunces\', Georgia, serif;\\n  }\\n\\n  code, pre, .font-mono, table.mono-table {\\n    font-family: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\\n    font-variant-numeric: tabular-nums;\\n  }\\n}\\n\\n.tabular-nums {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n/* Custom subtle scrollbars for museum panels */\\n::-webkit-scrollbar {\\n  width: 6px;\\n  height: 6px;\\n}\\n\\n::-webkit-scrollbar-track {\\n  background: #07090E;\\n}\\n\\n::-webkit-scrollbar-thumb {\\n  background: #1E293B;\\n  border-radius: 3px;\\n}\\n\\n::-webkit-scrollbar-thumb:hover {\\n  background: #334155;\\n}\\n\", \"Description\":\"Configure global typography and museum dark slate styles in src/index.css\", \"Overwrite\":true, \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Updating src/index.css\", \"toolSummary\":\"Update src/index.css\"}"
