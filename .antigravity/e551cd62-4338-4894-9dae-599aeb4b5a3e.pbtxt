          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        earthMat.needsUpdate = true;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // 2. Atmosphere Glow Halo (soft atmospheric white-blue)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const atmosGeo = new THREE.SphereGeometry(EARTH_RADIUS * 1.016, 64, 64);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const atmosMat = new THREE.ShaderMaterial({"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      uniforms: {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        u_umbra_pos: { value: new THREE.Vector3(0, 1, 0) },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        u_sun_pos: { value: new THREE.Vector3(1, 0, 0) },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        u_has_umbra: { value: 0.0 }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      vertexShader: `"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec3 vNormal;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec3 vPositionWorld;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        void main() {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vNormal = normalize(normalMatrix * normal);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vec4 worldPos = modelMatrix * vec4(position, 1.0);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          vPositionWorld = normalize(worldPos.xyz);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      `,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      fragmentShader: `"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform vec3 u_umbra_pos;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform vec3 u_sun_pos;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        uniform float u_has_umbra;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec3 vNormal;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        varying vec3 vPositionWorld;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
